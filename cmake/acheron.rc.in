#include <winver.h>
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/acheron.ico"
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "ProductName", "Acheron Custom\0"
   VALUE "FileDescription", "Acheron Custom\0"
   VALUE "FileVersion", "@ACHERON_VERSION@\0"
   VALUE "ProductVersion", "@ACHERON_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
